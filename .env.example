# Copie para .env e preencha. Nunca faça commit do arquivo .env.

# Project Settings → Data API (ou API) no painel do Supabase
SUPABASE_URL=https://uojxjcnggbfljtkmurgq.supabase.co

# Project Settings → API Keys → chave "service_role" (ou a secret key "sb_secret_...").
# É secreta: fica só no servidor, nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: senha para apagar skins pela API.
ADMIN_TOKEN=

PORT=3000

# Só para `npm run migrate`: Supabase → Connect → Session pooler.
SUPABASE_DB_URL=
